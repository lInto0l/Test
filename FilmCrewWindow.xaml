<Window x:Class="CinemaStudio.FilmCrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaStudio"
        mc:Ignorable="d"
    Title="Съемочные группы" Height="520" MinHeight="520" MinWidth="800" Width="880">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.03*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Name="CrewMembersTable" Grid.Column="0" ItemsSource="{Binding CrewMembers}" SelectedItem="{Binding SelectedCrew}" CanUserAddRows="False" AutoGenerateColumns="False" CanUserDeleteRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding FilmCrewId}"/>
                <DataGridTextColumn Header="Проект" Binding="{Binding FilmCrew.Project.Name}"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.Fullname}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="2" Margin="20 0 10 0">
            <Button Content="Сбросить" Click="ResetBtn_Click"  Margin="0 0 0 20" Height="30"/>

            <Label Content="Проект" FontWeight="SemiBold"/>
            <ComboBox Name="ProjectCombo" ItemsSource="{Binding Projects}" SelectedValuePath="Id"  SelectedValue="{Binding EditableCrew.FilmCrew.ProjectId}" DisplayMemberPath="Name"/>
            <Label Content="Сотрудник" FontWeight="SemiBold"/>
            <ComboBox Name="EmployeeCombo" ItemsSource="{Binding Employees}" SelectedValuePath="Id" SelectedValue="{Binding EditableCrew.EmployeeId}" DisplayMemberPath="Fullname"/>
            <Label Content="Специализация" FontWeight="SemiBold"/>
            <ComboBox Name="SpecialityCombo" IsEnabled="False" ItemsSource="{Binding Specialities}"  SelectedValuePath="Id" SelectedValue="{Binding EditableCrew.Employee.SpecialityId}" DisplayMemberPath="Name"/>

            <Button Content="Сохранить" Click="SaveBtn_Click"  Margin="0 30 0 0" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
