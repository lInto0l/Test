<Window x:Class="CinemaStudio.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaStudio"
        mc:Ignorable="d"
        Title="Проекты" Height="520" MinHeight="520" MinWidth="800" Width="880">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.03*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0 0 0 20">
            <Label Content="Фильтр по статусу"/>
            <ComboBox Name="StatusFilterCombo" DisplayMemberPath="Name" MinWidth="100" Margin="5 0 20 0"/>
            <Button Content="Найти" Padding="3" Click="FilterBtn_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" CanUserAddRows="False" AutoGenerateColumns="False" CanUserDeleteRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre.Name}"/>
                <DataGridTextColumn Header="Бюджет" Binding="{Binding Budget}"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate}"/>
                <DataGridTextColumn Header="Конец" Binding="{Binding EndDate}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}"/>
                <DataGridTextColumn Header="Аудитория" Binding="{Binding TargetAudience.Name}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Сбросить" Click="ResetBtn_Click" Grid.Column="2" Grid.Row="0" Height="30" Margin="20 0 10 5"/>
        
        <StackPanel Grid.Column="2" Grid.Row="1" Margin="20 0 10 0">
            <Label Content="Название" FontWeight="SemiBold"/>
            <TextBox Name="NameField" Text="{Binding EditableProject.Name}"/>
            <Label Content="Жанр" FontWeight="SemiBold"/>
            <ComboBox Name="GenreCombo" DisplayMemberPath="Name" SelectedValue="{Binding EditableProject.GenreId}" SelectedValuePath="Id"/>
            <Label Content="Бюджет" FontWeight="SemiBold"/>
            <TextBox Name="BudgetField" Text="{Binding EditableProject.Budget}"/>
            <Label Content="Дата начала" FontWeight="SemiBold"/>
            <DatePicker Name="StartDatePicker" DisplayDateStart="{Binding MinStartDate}" DisplayDateEnd="{Binding MaxStartDate}" SelectedDate="{Binding UIStartDate}"/>
            <Label Content="Дата конца" FontWeight="SemiBold"/>
            <DatePicker Name="EndDatePicker" DisplayDateStart="{Binding MinEndDate}" DisplayDateEnd="{Binding MaxEndDate}" SelectedDate="{Binding UIEndDate}"/>
            <Label Content="Статус" FontWeight="SemiBold"/>
            <ComboBox Name="StatusCombo" SelectedValue="{Binding EditableProject.StatusId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
            <Label Content="Аудитория" FontWeight="SemiBold"/>
            <ComboBox Name="AudienceCombo" SelectedValue="{Binding EditableProject.TargetAudienceId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>

            <Button Content="Сохранить" Click="SaveBtn_Click" Margin="0 30 0 0"/>
        </StackPanel>
    </Grid>
</Window>
